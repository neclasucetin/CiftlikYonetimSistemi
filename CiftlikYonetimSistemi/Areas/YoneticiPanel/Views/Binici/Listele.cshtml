@using CiftlikYonetimSistemi.Models
@model List<Biniciler>
@{
    ViewBag.Title = "Listele";
    Layout = "~/Areas/YoneticiPanel/Views/Shared/YoneticiLayout.cshtml";
}

<div class="card mt-4 shadow border-0 rounded-4">
    <div class="card-header bg-success text-white p-4 rounded-top-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1">🏇 Binici Yönetimi</h4>
                <small>Çiftlikte kayıtlı binicileri görüntüleyebilirsiniz.</small>
            </div>

            <a href="@Url.Action("Ekle", "Binici")" class="btn btn-light">
                + Yeni Binici Ekle
            </a>
        </div>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>İsim</th>
                <th>Soyisim</th>
                <th>Telefon</th>
                <th>Email</th>
                <th>Deneyim Seviyesi</th>
                <th>Seçenekler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Biniciler item in Model)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Isim</td>
                    <td>@item.Soyisim</td>
                    <td>@item.Telefon</td>
                    <td>@item.Email</td>
                    <td>@item.DeneyimSeviyesi</td>
                    <td>
                        <a href="@Url.Action("Duzenle", "Binici", new {id = item.ID} )" class="btn btn-primary btn-sm">Düzenle</a>
                        <a href="@Url.Action("Sil", "Binici", new {id = item.ID})" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
