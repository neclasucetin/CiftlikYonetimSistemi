@using CiftlikYonetimSistemi.Models
@model List<Pansiyonerler>
@{
    ViewBag.Title = "Listele";
    Layout = "~/Areas/YoneticiPanel/Views/Shared/YoneticiLayout.cshtml";
}

<div class="card mt-4 shadow border-0 rounded-4">
    <div class="card-header bg-success text-white p-4 rounded-top-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1">👥 Pansiyoner Yönetimi</h4>
                <small>Çiftlikte kayıtlı pansiyonerleri görüntüleyebilirsiniz.</small>
            </div>

            <a href="@Url.Action("Ekle", "Pansiyoner")" class="btn btn-light">
                + Yeni Pansiyoner Ekle
            </a>
        </div>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>İsim</th>
                <th>Soyisim</th>
                <th>Telefon</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Pansiyonerler item in Model)
            {
                <tr>
                    <td>@item.ID</td>
                    <td>@item.Isim</td>
                    <td>@item.Soyisim</td>
                    <td>@item.Telefon</td>
                    <td>@item.Email</td>
                    <td>
                        <a href="@Url.Action("Duzenle", "Pansiyoner", new {id = item.ID} )" class="btn btn-primary btn-sm">Düzenle</a>
                        <a href="@Url.Action("Sil", "Pansiyoner", new {id = item.ID})" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
