@using CiftlikYonetimSistemi.Models
@model List<Egitmenler>

@{
    ViewBag.Title = "Eğitmen Listele";
    Layout = "~/Areas/YoneticiPanel/Views/Shared/YoneticiLayout.cshtml";
}

<div class="card mt-4 shadow border-0 rounded-4">

    <div class="card-header bg-success text-white p-4 rounded-top-4">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h4 class="mb-1">👨‍🏫 Eğitmen Yönetimi</h4>
                <small>Çiftlikte kayıtlı eğitmenleri görüntüleyebilirsiniz.</small>
            </div>

            <a href="@Url.Action("Ekle", "Egitmen")" class="btn btn-light rounded-3">
                + Yeni Eğitmen Ekle
            </a>

        </div>
    </div>

    <div class="card-body p-4">

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">

                <thead class="table">
                    <tr>
                        <th>ID</th>
                        <th>İsim</th>
                        <th>Soyisim</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th>Uzmanlık Alanı</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (Egitmenler item in Model)
                    {
                        <tr>
                            <td>@item.ID</td>
                            <td>@item.Isim</td>
                            <td>@item.Soyisim</td>
                            <td>@item.Telefon</td>
                            <td>@item.Email</td>
                            <td>@item.UzmanlikAlani</td>

                            <td>
                                <a href="@Url.Action("Duzenle", "Egitmen", new { id = item.ID })" class="btn btn-primary btn-sm rounded-3">
                                    Düzenle
                                </a>

                                <a href="@Url.Action("Sil", "Egitmen", new { id = item.ID })" class="btn btn-danger btn-sm rounded-3">
                                    Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>