
@using CiftlikYonetimSistemi.Models
@model Atlar
@{
    ViewBag.Title = "Duzenle";
    Layout = "~/Areas/YoneticiPanel/Views/Shared/YoneticiLayout.cshtml";
}

<div class="card mt-3">
    <div class="card-header">
        <h4>At Düzenle</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {

            if (ViewBag.durum != null)
            {
                if (ViewBag.durum == true)
                {
                    <div class="alert alert-success">At Düzenleme Başarılı</div>
                }
                else
                {
                    <div class="alert alert-danger">At Düzenleme Başarısız</div>
                }
            }
            <div class="mt-2">
                <label>At Adı</label>
                @Html.EditorFor(model => model.AtAdi, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <label>At Yaşı</label>
                @Html.EditorFor(model => model.Yas, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <label>At Cinsiyeti</label>
                @Html.EditorFor(model => model.Cinsiyet, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <label>At Irkı</label>
                @Html.EditorFor(model => model.Irk, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <label>At Rengi</label>
                @Html.EditorFor(model => model.Renk, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <label>Atın Sağlık Durumu</label>
                @Html.EditorFor(model => model.SaglikDurumu, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <label>Atın Sahibi</label>
                @Html.EditorFor(model => model.Pansiyonerler_ID, new { htmlAttributes = new { @class = "form-control" } })
            </div>
            <div class="mt-2">
                <button type="submit" class="btn btn-primary">At Düzenle</button>
            </div>
        }
    </div>
</div>

