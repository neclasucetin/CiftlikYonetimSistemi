@model CiftlikYonetimSistemi.Areas.YoneticiPanel.Data.YoneticiGirisVeriTasiyicisi
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>GirisYap</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container position-absolute top-50 start-50 translate-middle mt-0">
        <div class="row shadow">
            <div class="col-md-6 p-5">
                <h1>Yönetici Giriş</h1>
                <label>Yönetim paneline erişmek için lütfen giriş bilgilerinizi doldurunuz.</label>
                <div style="height:40px"></div>
                @if (ViewBag.mesaj != null)
                {
                    <div class="alert alert-danger"> <strong> Hata!!!</strong> @ViewBag.mesaj</div>
                }
                @using (Html.BeginForm())
                {
                    <div class="mt-3">
                        <label>Mail Adresiniz</label>
                        @Html.EditorFor(model => model.Mail, new { htmlAttributes = new { @class = "form-control mt-2" } })
                        @Html.ValidationMessageFor(model => model.Mail, "", new { @class = "text-danger" })
                    </div>
                    <div class="mt-3">
                        <label>Şifreniz</label>
                        @Html.EditorFor(model => model.Sifre, new { htmlAttributes = new { @class = "form-control mt-2" } })
                        @Html.ValidationMessageFor(model => model.Sifre, "", new { @class = "text-danger" })
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Panel'e Giriş Yap</button>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <img src="~/Images/yoneticihorse.png" class="img-fluid" />
            </div>
        </div>
    </div>
</body>
</html>

